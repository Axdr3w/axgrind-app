VITE_SUPABASE_URL=your-project-url-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:you@example.com

# Optional, local dev only — never set these in a deployed environment.
# When both are present, `npm run dev` auto-signs in as this account on
# load instead of showing the login form. Only takes effect inside Vite's
# dev server (import.meta.env.DEV); a production build never reads these.
VITE_DEV_AUTO_LOGIN_EMAIL=
VITE_DEV_AUTO_LOGIN_PASSWORD=
